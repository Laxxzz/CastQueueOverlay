# What a deployed or packaged CastQueueOverlay leaves out. The live deploy honours
# this ignore list; the release zip is built by dev/Package.ps1 from the .toc, art/
# and fonts/, and agrees with it. There is no BigWigs packager or CI release any more:
# dev/Publish.ps1 publishes, with the "## <version>" section of CHANGELOG.md as the
# notes on every channel.
package-as: CastQueueOverlay

ignore:
  - .github
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - .claude
  - README.md
  - LICENSE
  - CHANGELOG.md
  - media
  # Superseded API notes kept for reference only. They are NOT loaded by the
  # client, and one of them documents ColorPicker's cancelFunc incorrectly, so
  # shipping them to players is worse than useless.
  - docs
  # The art generator. `art/` itself IS shipped - the client loads it - but the
  # Python script that produces it is a maintainer tool.
  - dev
