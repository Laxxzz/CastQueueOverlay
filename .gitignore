# Claude Code config — machine-specific and not useful to anyone cloning this.
# It carries absolute paths (and therefore a username) and local tool
# permissions, so it stays out of a public repo entirely.
.claude/

# WoW writes saved variables to WTF\, never into the addon folder, so there is
# nothing of the player's to exclude here. Listed only so the next person does
# not go looking for it.

# Packaging artifacts
*.zip
*.rar
*.7z

# Editor / OS noise
*.bak
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

