# Claude Code local overrides — machine-specific, not shared.
# .claude/settings.json IS tracked: it carries the project's permissions and the
# additionalDirectories pointing at the API reference and the AddOns folder.
.claude/settings.local.json

# WoW writes saved variables to WTF\, never into the addon folder, so there is
# nothing of the player's to exclude here. Listed only so the next person does
# not go looking for it.

